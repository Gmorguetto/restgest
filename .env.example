# Copie este arquivo para .env e troque os valores.
# O arquivo .env NÃO vai para o GitHub (está no .gitignore).

# Chave que assina a sessão de login. Gere uma com:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-por-uma-chave-aleatoria

# Senha dos usuários de demonstração criados pelo comando "flask seed-demo"
# (mínimo 6 caracteres).
SENHA_DEMO=troque-esta-senha
